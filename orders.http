@baseUrl = http://localhost:8080
@productId = 00000000-0000-0000-0000-000000000001
@orderId = 00000000-0000-0000-0000-000000000002
@idempotencyKey = 6b5c9e2d-9691-4550-a4a8-7daeb2aebc13

### Validate inventory without reserving it
POST {{baseUrl}}/api/cart/validate
Content-Type: application/json

{
  "items": [
    {
      "productId": "{{productId}}",
      "quantity": 1
    }
  ]
}

### Create an idempotent guest order and reserve inventory
POST {{baseUrl}}/api/orders
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "customerName": "Taylor Morgan",
  "customerEmail": "taylor@example.test",
  "shippingAddress": "100 Main Street, Springfield",
  "items": [
    {
      "productId": "{{productId}}",
      "quantity": 1
    }
  ]
}

### Read order status
GET {{baseUrl}}/api/orders/{{orderId}}

### Cancel a reserved order using its original capability key
POST {{baseUrl}}/api/orders/{{orderId}}/cancel
Idempotency-Key: {{idempotencyKey}}
